# Studi environment template.
# Copy to .env.local for local frontend values and set backend-only secrets in Convex.
# Placeholder values only. Never commit real API keys, tokens, private keys, or webhook secrets.

# Convex
NEXT_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud
CONVEX_DEPLOYMENT=dev:placeholder

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_ISSUER_DOMAIN=https://placeholder.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_placeholder

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-placeholder

# OpenAI Realtime / voice restoration
OPENAI_API_KEY=sk-placeholder
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=placeholder_voice
VOICE_SMOKE_ENABLED=false
VOICE_SMOKE_REQUIRE_MIC=false

# Daytona / labs restoration
DAYTONA_API_KEY=daytona_placeholder
DAYTONA_ORG_ID=org_placeholder
DAYTONA_TARGET_REGION=region_placeholder
DAYTONA_DEFAULT_IMAGE=image_placeholder
LAB_SMOKE_ENABLED=false
LAB_SMOKE_TIMEOUT_MS=60000

# Desmos
NEXT_PUBLIC_DESMOS_API_KEY=desmos_placeholder

# Tally waitlist
NEXT_PUBLIC_TALLY_WAITLIST_FORM_URL=https://tally.so/r/placeholder
TALLY_WEBHOOK_SECRET=tally_placeholder

# PostHog telemetry
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_placeholder
POSTHOG_PROJECT_ID=project_placeholder

# Model routing placeholders for future restoration branches.
STUDI_AGENT_MODEL=provider/model-placeholder
CODI_AGENT_MODEL=provider/model-placeholder
SHRU_TEXT_FALLBACK_MODEL=provider/model-placeholder
PLAN_WORKER_MODEL=provider/model-placeholder
SPARK_WORKER_MODEL=provider/model-placeholder
SPARK_WORKER_SCENE_MODEL=provider/model-placeholder
SPARK_WORKER_DESMOS_MODEL=provider/model-placeholder
SPARK_WORKER_CODE_MODEL=provider/model-placeholder
SPARK_WORKER_QUIZ_MODEL=provider/model-placeholder
SPARK_WORKER_FLASH_MODEL=provider/model-placeholder

# Spark worker timeouts
SPARK_WORKER_TIMEOUT_MS=30000
SPARK_WORKER_SCENE_TIMEOUT_MS=30000
SPARK_WORKER_DESMOS_TIMEOUT_MS=30000
SPARK_WORKER_CODE_TIMEOUT_MS=45000
SPARK_WORKER_QUIZ_TIMEOUT_MS=30000
SPARK_WORKER_FLASH_TIMEOUT_MS=30000

# Live smoke tests are opt-in and must use rotated credentials.
AI_SMOKE_ENABLED=false
DAYTONA_SMOKE_ENABLED=false
OPENAI_REALTIME_SMOKE_ENABLED=false
SMOKE_REPORT_DIR=.tmp/smoke
