{
  "name": "studi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --webpack",
    "dev:backend": "convex dev",
    "predev": "bun run prompts:sync && convex dev --until-success",
    "build": "next build",
    "prebuild": "bun run prompts:sync",
    "start": "next start",
    "lint": "eslint app components convex lib",
    "lint:all": "eslint .",
    "test": "bun run test:unit && bun run test:convex",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:e2e": "playwright test --grep-invert @live-code-spark-provider",
    "test:e2e:auth": "playwright test tests/e2e/authenticated-chat.spec.ts",
    "test:e2e:code-spark:real": "E2E_CODE_SPARK_REAL_CHAT=1 playwright test tests/e2e/code-spark-real-chat.spec.ts --grep @live-code-spark-provider",
    "test:e2e:code-spark:visual": "E2E_CODE_SPARK_REAL_CHAT=1 playwright test tests/e2e/code-spark-redesign-visual.spec.ts --grep @live-code-spark-provider",
    "test:all": "bun run test && bun run test:e2e",
    "check": "bun run prompts:check && bun run lint && bun run test && bun run build",
    "prompts:sync": "bun lib/prompts/sync.ts",
    "prompts:check": "bun lib/prompts/sync.ts --check",
    "browser:auth-url": "bun scripts/create-clerk-agent-task.ts",
    "billing:reset-dev-test-user": "bun scripts/reset-dev-test-billing.ts",
    "playground": "bunx @convex-dev/agent-playground",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.config.ts --project storybook",
    "check:storybook": "bun run test:storybook && bun run build-storybook"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.85",
    "@clerk/backend": "2.33.5",
    "@clerk/clerk-react": "5.61.8",
    "@clerk/nextjs": "6.39.5",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "1.2.0",
    "@vercel/sandbox": "2.5.0",
    "ai": "5.0.82",
    "clsx": "^2.1.1",
    "convex": "1.42.1",
    "framer-motion": "12.34.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.575.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@clerk/testing": "2.2.7",
    "@convex-dev/eslint-plugin": "^1.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.11.1",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-storybook": "^10.5.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "9.0.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "dompurify": "3.4.12",
    "flatted": "3.4.2",
    "postcss": "8.5.17",
    "undici": "7.28.0"
  }
}
