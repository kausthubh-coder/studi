{
  "name": "studi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "bun run prompts:sync && convex dev --until-success",
    "build": "next build",
    "prebuild": "bun run prompts:sync",
    "start": "next start",
    "lint": "eslint app components convex lib",
    "lint:all": "eslint .",
    "test": "bun run test:unit && bun run test:convex",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "check": "bun run prompts:check && bun run lint && bun run test && bun run build",
    "prompts:sync": "bun lib/prompts/sync.ts",
    "prompts:check": "bun lib/prompts/sync.ts --check",
    "playground": "bunx @convex-dev/agent-playground"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.0",
    "@clerk/clerk-react": "^5.60.0",
    "@clerk/nextjs": "^6.37.3",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "1.2.0",
    "@vercel/sandbox": "^2.4.0",
    "ai": "5.0.82",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "framer-motion": "^12.34.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.575.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.33",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
