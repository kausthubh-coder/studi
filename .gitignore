# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright/.clerk/

# next.js
/.next/
/out/

# production
/build

# misc
.cache/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# reference-only examples
/examples/
/examples/**
.env.local

# scratch / temp artifacts
/.tmp/
/.tmp/**

# local Oracle/browser evidence (may contain machine or provider metadata)
/.artifacts/
/test-results/
/.design/
/.sandbox/

*storybook.log
storybook-static/
